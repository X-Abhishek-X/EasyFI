# Copy to .env.local (web) / .env (jobs). Leave blank to run in local demo mode
# (embedded PGlite database + fixture market data + fake LLM).

# Supabase (Auth + Postgres)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Postgres connection used by Drizzle (Supabase pooler URL in production)
DATABASE_URL=

# Market data — https://www.tiingo.com (free tier)
TIINGO_TOKEN=

# SEC EDGAR requires a descriptive User-Agent: "EasyFI you@example.com"
SEC_USER_AGENT=

# BLS Public Data API v2 — https://data.bls.gov/registrationEngine/
BLS_KEY=

# LLM for the Investment Explorer — https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Local demo mode (no Supabase): set to 1. Refused when NODE_ENV=production.
EASYFI_DEMO=

# Comma-separated invite codes accepted at sign-up
INVITE_CODES=
