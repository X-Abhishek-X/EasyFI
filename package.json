{
  "name": "easyfi",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter @easyfi/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm test:repo && turbo run lint typecheck test build",
    "test": "turbo run test",
    "test:repo": "vitest run --root tooling"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@vitest/coverage-v8": "^3",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver",
      "sharp"
    ]
  }
}
